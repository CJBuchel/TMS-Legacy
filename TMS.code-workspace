{
  "folders": [{ "path": "." }],
  "settings": {
    "files.watcherExclude": {
      "**/target/**": true,
      "**/.dart_tool/**": true,
      "**/build/**": true,
      "**/node_modules/**": true,
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/android/.gradle/**": true,
      "**/ios/Pods/**": true,
      "**/.flutter-plugins-dependencies": true
    },
    "search.exclude": {
      "**/target/**": true,
      "**/.dart_tool/**": true,
      "**/build/**": true,
      "**/node_modules/**": true,
      "**/*.lock": true,
      "**/Cargo.lock": false,
      "**/pubspec.lock": false
    },
    "files.exclude": {
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/CVS": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true
    },
    "rust-analyzer.files.excludeDirs": [
      "target",
      ".dart_tool",
      "build",
      "node_modules"
    ],
    "dart.analysisExcludedFolders": ["**/target", "**/build", "**/.dart_tool"],
    "typescript.disableAutomaticTypeAcquisition": true
  }
}
