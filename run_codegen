#!/bin/bash
set -e

# colors
G='\033[0;32m'   #'0;32' is Green's ANSI color code
N='\033[0m'      # reset

#
# TMS INFRA bindings
#
ROOT=$(cd "$(dirname "$0")" && pwd)
TMS_INFRA=$ROOT/tms_infra
TMS_FLUTTER=$ROOT/tms_client

# codegen for flutter (this also runs build_runner for the freezed outputs)
echo -e "${G}Running codegen for $TMS_INFRA${N}"
(cd "$TMS_FLUTTER" && flutter_rust_bridge_codegen generate)

# build wasm for the web client
# The bridge is fully synchronous (default_dart_async: false), so the wasm never uses threads.
# That means a plain stable wasm-pack build is enough: no nightly, no build-std, no cross-origin isolation headers.
echo -e "${G}Building wasm for $TMS_INFRA${N}"
wasm-pack build "$TMS_INFRA" --target no-modules --out-dir "$TMS_FLUTTER/web/pkg" --no-typescript --out-name tms_infra --release
